{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Pytest debug",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/test_models.py",
                "-q"
            ],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/venv/bin/python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src${pathSeparator}${workspaceFolder}"
            }
        }
    ]
}